# YouCam API credentials.
# Get a key from https://yce.makeupar.com/api-console -> API Keys.
# Never commit the real value. Copy this file to .env.local and fill it in.
YOUCAM_API_KEY=
# Optional. Defaults to the production endpoint used by the hackathon.
YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com

# --- Security / abuse controls (required for any public deployment) ---

# HMAC secret that signs the render ticket binding a measurement to its photo.
# Generate with: openssl rand -base64 32
# Without it, live rendering is refused; analysis and the recorded sample still work.
CHROMA_TICKET_SECRET=

# Shared secret required from clients, sent as `Authorization: Bearer <token>`.
# Leave unset only if the deployment is genuinely private.
CHROMA_API_TOKEN=

# Upstash Redis REST endpoint for the distributed rate limit and daily spend cap.
# The paid endpoints FAIL CLOSED (503) if these are missing, so set them before
# going live. Create a free database at https://upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional tuning.
CHROMA_RATE_LIMIT_PER_MIN=8
CHROMA_DAILY_UNIT_CEILING=2000
CHROMA_IMAGE_FETCH_TIMEOUT_MS=10000
# Extra origins allowed to call the API, comma-separated. Same-origin is always
# allowed; add entries only when a trusted front end lives on another host.
CHROMA_ALLOWED_ORIGINS=
